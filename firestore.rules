rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: Tolak semua akses jika tidak diizinkan secara eksplisit
    match /{document=**} {
      allow read, write: if false;
    }

    // Koleksi Publik: Katalog Produk & Artikel (Hanya BACA)
    match /products/{productId} {
      // F-014: produk nonaktif (atau tanpa isActive) hanya terbaca lewat Admin SDK (server).
      // List ditolak: tidak ada kode client yang me-list produk.
      allow get: if resource.data.get('isActive', false) == true;
      allow list: if false;
      allow write: if false;
    }
    
    match /articles/{articleId} {
      // F-012: draf hanya terbaca lewat Admin SDK (server). Dokumen lama tanpa status tetap publik.
      // List ditolak: tidak ada kode client yang me-list artikel.
      allow get: if resource.data.get('status', 'published') == 'published';
      allow list: if false;
      allow write: if false;
    }

    // Koleksi Proteksi Admin (Hanya bisa diakses via Admin SDK/API Server)
    // Client-side tidak bisa membaca/menulis data ini sama sekali
    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /vouchers/{voucherCode} {
      allow read, write: if false;
    }

    match /affiliates/{affiliateId} {
      allow read, write: if false;
    }

    match /commissions/{commissionId} {
      allow read, write: if false;
    }
  }
}
